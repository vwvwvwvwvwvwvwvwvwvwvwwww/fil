# Первичный советник (создаётся при старте, если отсутствует в БД)
ADMIN_EMAIL=advisor@example.com
ADMIN_PASSWORD=change_me_secure

# Скрытый URL входа советника: один сегмент 16–128 символов [a-zA-Z0-9_-], без слэшей.
# Пример: advisor-int-hf92kx7q — тогда страница входа открывается по адресу /advisor-int-hf92kx7q
# Оставьте пустым на своём компьютере для разработки (можно открыть /admin/login.html напрямую).
STAFF_ENTRY_PATH=

# Пароль для демонстрационных учёток волонтёров (seed в БД при первом создании)
VOLUNTEER_DEMO_PASSWORD=VolunteerDemo2026

# Пароль для демо-учёток сотрудников (сид при старте: Семикина, Жиганова, Кустумова — см. seedStaffAccounts в db.js).
# В продакшене задайте свой надёжный пароль и при необходимости замените email через STAFF_SEMIKINA_EMAIL и т.д.
STAFF_ACCOUNTS_PASSWORD=StaffDemo2026
# STAFF_SEMIKINA_EMAIL=
# STAFF_ZHIGANOVA_EMAIL=
# STAFF_KUSTOMOVA_EMAIL=

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# База данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///./data/app.db

# Лента ВКонтакте на странице «Новости колледжа»
# Без токена сервер отдаёт ручной снимок static/data/vk-gapou-wall-cache.json (можно править).
# Живая лента: https://dev.vk.com → приложение → сервисный ключ доступа → VK_ACCESS_TOKEN.
VK_ACCESS_TOKEN=
VK_GROUP_DOMAIN=gapou_okei
VK_WALL_COUNT=12
VK_WALL_CACHE_SECONDS=600

# --- Railway / продакшен (см. RAILWAY.md) ---
# PORT и RAILWAY_* задаёт платформа. Лог только в консоль:
# LOG_FILE=-
# Явно отключить secure-cookie или trust proxy: COOKIE_SECURE=0  TRUST_PROXY=0
